{
  "manifest_version": 3,
  "name": "My AdBlocker",
  "version": "1.1",
  "description": "Tiện ích chặn quảng cáo và tracker bảo mật bằng Manifest V3",
  "permissions": [
    "declarativeNetRequest",
    "declarativeNetRequestFeedback",
    "storage",
    "activeTab",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "rules_ads",
        "enabled": true,
        "path": "rules/rules_ads.json"
      },
      {
        "id": "rules_trackers",
        "enabled": true,
        "path": "rules/rules_trackers.json"
      },
      {
        "id": "rules_popups",
        "enabled": true,
        "path": "rules/rules_popups.json"
      }
    ]
  },
  "background": {
    "service_worker": "background/background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "css": ["content/hide-ads.css"],
      "js": ["content/content.js"],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "My AdBlocker",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_ui": {
    "page": "dashboard.html",
    "open_in_tab": true
  }
}
